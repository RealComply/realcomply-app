NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never expose these to the browser (no NEXT_PUBLIC_ prefix).

# Supabase service_role key. Bypasses Row Level Security entirely — only
# used by the weekly digest cron job, which has no logged-in user to scope
# queries to and needs to read across every agency in one run. Get it from
# Supabase project settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AWS SES (ap-southeast-2 / Sydney) SMTP credentials for the
# notifications.realcomply.com.au sending identity. IAM user
# realcomply-notifications-smtp, scoped to ses:SendRawEmail only.
SES_SMTP_HOST=email-smtp.ap-southeast-2.amazonaws.com
SES_SMTP_PORT=587
SES_SMTP_USER=your-smtp-username
SES_SMTP_PASSWORD=your-smtp-password
EMAIL_FROM="RealComply <notifications@notifications.realcomply.com.au>"

# Where new-agency signup notifications go.
ADMIN_NOTIFICATION_EMAIL=admin@realcomply.com.au

# Shared secret the weekly-digest cron route checks for, so the endpoint
# can't be triggered by anyone who finds the URL. Vercel sends this
# automatically as a bearer token for its own Cron requests once configured
# in Project Settings → Cron Jobs — this value just has to match.
CRON_SECRET=a-long-random-string

# Secret used to derive the unsubscribe token in early-access emails. Any long
# random string. Changing it invalidates every unsubscribe link already sent,
# so set it once and leave it. If unset, the acknowledgement email still goes
# out but offers a reply-to-unsubscribe instead of a link.
EMAIL_UNSUBSCRIBE_SECRET=a-long-random-string

# Public site origin, used to build links in outbound email.
NEXT_PUBLIC_SITE_URL=https://www.realcomply.com.au
